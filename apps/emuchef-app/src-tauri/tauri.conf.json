{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EmuChef",
  "version": "0.1.0",
  "identifier": "com.emuchef.desktop",
  "build": {
    "beforeBuildCommand": "npm run sidecar:build && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EmuChef",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; connect-src ipc: http://ipc.localhost; font-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; object-src 'none'; script-src 'self'; style-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "externalBin": ["binaries/emuchef"],
    "resources": {
      "../../../authored/apps": "catalog/apps",
      "../../../authored/device_plans": "catalog/device_plans",
      "../../../authored/device_profiles": "catalog/device_profiles",
      "../../../authored/recipes": "catalog/recipes"
    }
  }
}
