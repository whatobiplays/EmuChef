    },
    {
      "id": "rust_tauri_checks",
      "command": "cargo test --manifest-path crates/emuchef-rust-backend/Cargo.toml shadow && cargo test --manifest-path crates/emuchef-rust-backend/Cargo.toml planner && cargo test --manifest-path crates/emuchef-rust-backend/Cargo.toml && cd apps/config-editor/src-tauri && cargo test && cd ../ && npm run check:rust-runtime"
    },
    {
      "id": "p8aj_rust_production_equivalent_live_probe_smoke",
