      "partialChangePresentation": "possible_partial_change",
      "authorityInvalidated": false,
      "recoveryState": "fresh_review_required",
      "authoredTitle": "Execution cancelled",
      "authoredIssueText": "This action was cancelled at a safe boundary.",
      "authoredRemediation": "Review the retained results, then create and review a fresh plan before another execution. The old execution cannot resume.",
      "requiredArtifactKind": "ui_state_capture",
      "forbiddenControls": ["resume", "replay", "checkpoint", "ownership_transfer"]
    },
    "transport": {
      "allowedIssueCodes": ["device_transport_lost"],
      "terminalStepProjection": "failed",
      "notAttemptedRequired": true,
      "partialChangePresentation": "possible_partial_change",
      "authorityInvalidated": true,
      "recoveryState": "requalification_required",
      "authoredTitle": "Reconnect and requalify",
      "authoredIssueText": "The device connection was lost during execution.",
      "authoredRemediation": "Reconnect or authorize the intended reviewed device, then complete fresh qualification and generate and review a fresh plan before another real run. Reconnecting does not resume the old execution.",
      "requiredArtifactKind": "ui_state_capture",
      "forbiddenControls": ["resume", "replay", "checkpoint", "ownership_transfer"]
    },
    "root": {
      "allowedIssueCodes": ["root_authority_revoked"],
      "terminalStepProjection": "failed",
      "notAttemptedRequired": true,
      "partialChangePresentation": "possible_partial_change",
      "authorityInvalidated": true,
      "recoveryState": "root_requalification_required",
      "authoredTitle": "Requalify root access",
      "authoredIssueText": "Root access was revoked during execution.",
      "authoredRemediation": "Complete fresh root qualification, generate a fresh plan, review it, and start a new execution. The old execution cannot be resumed.",
      "requiredArtifactKind": "ui_state_capture",
      "forbiddenControls": ["resume", "replay", "checkpoint", "ownership_transfer"]
    },
    "storage": {
      "allowedIssueCodes": ["device_storage_exhausted"],
      "terminalStepProjection": "failed",
      "notAttemptedRequired": true,
      "partialChangePresentation": "possible_partial_change",
      "authorityInvalidated": true,
      "recoveryState": "fresh_qualification_required",
      "authoredTitle": "Free storage and start again",
      "authoredIssueText": "The device ran out of storage during execution.",
      "authoredRemediation": "Free device storage, complete fresh qualification, then generate and review a fresh plan before starting a new execution. The old execution cannot resume.",
      "requiredArtifactKind": "ui_state_capture",
      "forbiddenControls": ["resume", "replay", "checkpoint", "ownership_transfer"]
    },
    "host_sleep": {
      "allowedIssueCodes": ["operation_timed_out"],
      "terminalStepProjection": "failed",
      "notAttemptedRequired": true,
      "partialChangePresentation": "indeterminate",
      "authorityInvalidated": true,
      "recoveryState": "fresh_qualification_required",
      "authoredTitle": "Repair and retry",
      "authoredIssueText": "A device operation timed out.",
      "authoredRemediation": "Resolve the reported feature problem, then generate and review a fresh plan.",
      "requiredArtifactKind": "ui_state_capture",
      "forbiddenControls": ["resume", "replay", "checkpoint", "ownership_transfer"]
    }
