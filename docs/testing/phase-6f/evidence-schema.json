{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repo://emuchef/phase-6f/evidence-schema",
  "title": "Phase 6F Physical Qualification Evidence Record",
  "description": "Immutable machine-readable record of one physical qualification run for a device target and canonical workflow.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "recordDigest",
    "capturedAt",
    "workflowId",
    "workflowVersion",
    "deviceTarget",
    "fingerprint",
    "fingerprintDigest",
    "runValidity",
    "qualificationOutcome",
    "automatedObservations",
    "humanCheckpoints",
    "targetWideFailure",
    "limitations"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "runId": {
      "type": "string",
      "pattern": "^phase-6f-run-sha256:[0-9a-f]{64}$"
    },
    "recordDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time"
    },
    "workflowId": {
      "type": "string",
      "minLength": 1
    },
    "workflowVersion": {
      "type": "integer",
      "minimum": 1
    },
    "deviceTarget": {
      "$ref": "#/$defs/deviceTarget"
    },
    "fingerprint": {
      "$ref": "#/$defs/fingerprint"
    },
    "fingerprintDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "runValidity": {
      "enum": [
        "valid",
        "invalid"
      ]
    },
    "qualificationOutcome": {
      "enum": [
        "passed",
        "failed",
        "not_observed"
      ]
    },
    "automatedObservations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/automatedObservation"
      }
    },
    "humanCheckpoints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/humanCheckpoint"
      }
    },
    "targetWideFailure": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "enum": [
            "device_identity_unverified",
            "device_identity_changed",
            "required_device_prerequisite_unavailable",
            "safety_invariant_failed"
          ]
        }
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "deviceTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "profileId",
        "manufacturer",
        "model",
        "androidVersion",
        "androidApi",
        "abiSocClass",
        "rootState",
        "connectionType",
        "firmwareBuild"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "profileId": {
          "type": "string",
          "minLength": 1
        },
        "manufacturer": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "androidVersion": {
          "type": "string",
          "minLength": 1
        },
        "androidApi": {
          "type": "integer",
          "minimum": 1
        },
        "abiSocClass": {
          "type": "string",
          "minLength": 1
        },
        "rootState": {
          "enum": [
            "non_root",
            "rooted"
          ]
        },
        "connectionType": {
          "enum": [
            "usb2",
            "usb3"
          ]
        },
        "firmwareBuild": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "emuchefBuild",
        "workflowVersion",
        "authoredContent",
        "runtimeContract",
        "deviceProfile",
        "androidApi",
        "firmwareBuild",
        "abiSocClass",
        "rootState",
        "connectionType"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "emuchefBuild": {
          "type": "string",
          "minLength": 1
        },
        "workflowVersion": {
          "type": "integer",
          "minimum": 1
        },
        "authoredContent": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "sha256"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "runtimeContract": {
          "type": "string",
          "minLength": 1
        },
        "deviceProfile": {
          "type": "string",
          "minLength": 1
        },
        "androidApi": {
          "type": "integer",
          "minimum": 1
        },
        "firmwareBuild": {
          "type": "string",
          "minLength": 1
        },
        "abiSocClass": {
          "type": "string",
          "minLength": 1
        },
        "rootState": {
          "enum": [
            "non_root",
            "rooted"
          ]
        },
        "connectionType": {
          "enum": [
            "usb2",
            "usb3"
          ]
        }
      }
    },
    "automatedObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "outcome",
        "observedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "enum": [
            "passed",
            "failed"
          ]
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "humanCheckpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpointId",
        "outcome",
        "observedAt"
      ],
      "properties": {
        "checkpointId": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "enum": [
            "pass",
            "fail",
            "unable_to_verify"
          ]
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
